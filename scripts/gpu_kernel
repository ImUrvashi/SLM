#!/home/urvashib/projects/SLM/.venv/bin/python.real
"""Jupyter kernel launcher that always runs the kernel on the GPU compute node.

Used by the "SLM .venv (GPU compute node)" kernelspec (slm-venv).

- On the compute node (e.g. inside a PBS batch job): starts ipykernel directly.
- On master: submits an interactive PBS job to GPU_only, starts ipykernel there on a
  free GPU, and tunnels the kernel's ZMQ ports back to master over SSH. When the kernel
  is shut down/restarted (or VS Code goes away) the PBS job is deleted.
"""
import json
import os
import shlex
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

PROJECT = Path("/home/urvashib/projects/SLM")
PYTHON = PROJECT / ".venv/bin/python.real"
COMPUTE_HOST = "compute"
QUEUE = "GPU_only"
NCPUS = 8
RUNTIME = Path.home() / ".local/share/jupyter/runtime/gpu-kernels"  # on shared /home
PORT_KEYS = ("shell_port", "iopub_port", "stdin_port", "control_port", "hb_port")

# Picks the GPU with the least memory in use (the node is shared with other users).
PICK_GPU = (
    "nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits"
    " | sort -t, -k2 -n | head -1 | cut -d, -f1"
)


def log(msg):
    print(f"[gpu_kernel] {msg}", file=sys.stderr, flush=True)


def connection_file():
    args = sys.argv[1:]
    if len(args) != 2 or args[0] != "-f":
        sys.exit("usage: gpu_kernel -f <connection_file>")
    return Path(args[1])


def run_local(conn):
    """Already on a GPU node: run ipykernel here with all GPUs visible."""
    os.environ.pop("CUDA_VISIBLE_DEVICES", None)  # all 8 GPUs visible
    os.execv(str(PYTHON), [str(PYTHON), "-m", "ipykernel_launcher", "-f", str(conn)])


def run_remote(conn):
    info = json.loads(conn.read_text())
    RUNTIME.mkdir(parents=True, exist_ok=True)
    os.chmod(RUNTIME, 0o700)
    # Remove files left behind by kernels that were killed without cleaning up.
    for alive in RUNTIME.glob("*.alive"):
        if time.time() - alive.stat().st_mtime > 300:
            for f in RUNTIME.glob(f"{alive.stem}.*"):
                f.unlink(missing_ok=True)
    tag =f"{conn.stem}-{os.getpid()}"
    remote_conn = RUNTIME / f"{tag}.json"
    jobid_file = RUNTIME / f"{tag}.jobid"
    heartbeat = RUNTIME / f"{tag}.alive"
    job_script = RUNTIME / f"{tag}.sh"

    info["ip"] = "127.0.0.1"
    remote_conn.write_text(json.dumps(info))
    os.chmod(remote_conn, 0o600)
    heartbeat.touch()

    # Runs on the compute node inside the PBS job.
    job_script.write_text(f"""#!/bin/bash
echo "$PBS_JOBID" > {shlex.quote(str(jobid_file))}
cd {shlex.quote(os.getcwd())} 2>/dev/null || cd {shlex.quote(str(PROJECT))}
source {shlex.quote(str(PROJECT / '.venv/bin/activate'))}
unset CUDA_VISIBLE_DEVICES
python.real -m ipykernel_launcher -f {shlex.quote(str(remote_conn))} &
KPID=$!
# Stop the kernel if master stops sending heartbeats (VS Code crashed, master rebooted, ...).
while kill -0 $KPID 2>/dev/null; do
  sleep 20
  if [ $(( $(date +%s) - $(stat -c %Y {shlex.quote(str(heartbeat))} 2>/dev/null || echo 0) )) -gt 120 ]; then
    kill $KPID
  fi
done
wait $KPID
""")
    os.chmod(job_script, 0o700)

    # qsub -I needs a terminal, so run it under `script` to give it a pseudo-terminal.
    qsub_cmd = (
        f"qsub -I -q {QUEUE} -l select=1:ncpus={NCPUS} -N slm-kernel "
        f"-- /bin/bash {shlex.quote(str(job_script))}"
    )
    job = subprocess.Popen(
        ["script", "-qfec", qsub_cmd, "/dev/null"],
        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    log(f"submitted kernel job to {QUEUE}, waiting for it to start ...")

    tunnel = None

    def cleanup(*_):
        jobid = jobid_file.read_text().strip() if jobid_file.exists() else ""
        if jobid:
            subprocess.run(["qdel", jobid], capture_output=True)
        for p in (tunnel, job):
            if p and p.poll() is None:
                try:
                    os.killpg(p.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
        for f in (remote_conn, jobid_file, heartbeat, job_script):
            f.unlink(missing_ok=True)
        sys.exit(0)

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, cleanup)

    while not jobid_file.exists():
        if job.poll() is not None:
            log("PBS job ended before the kernel started (check `qstat -Q`, max 2 jobs per user)")
            cleanup()
        time.sleep(1)
    log(f"job {jobid_file.read_text().strip()} running on {COMPUTE_HOST}")

    forwards = []
    for key in PORT_KEYS:
        forwards += ["-L", f"127.0.0.1:{info[key]}:127.0.0.1:{info[key]}"]
    tunnel = subprocess.Popen(
        ["ssh", "-N", "-o", "BatchMode=yes", "-o", "LogLevel=QUIET", "-o", "ExitOnForwardFailure=yes",
         "-o", "ServerAliveInterval=30", *forwards, COMPUTE_HOST],
        stdin=subprocess.DEVNULL, start_new_session=True,
    )

    while job.poll() is None:
        heartbeat.touch()
        if tunnel.poll() is not None:
            log("SSH tunnel to compute node closed")
            break
        time.sleep(2)
    cleanup()


def main():
    conn = connection_file()
    if socket.gethostname().split(".")[0] == COMPUTE_HOST:
        run_local(conn)
    else:
        run_remote(conn)


if __name__ == "__main__":
    main()
